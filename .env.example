# ============================================
# 环境变量模板
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填入真实值（API Key、密码等）
# 3. .env 已在 .gitignore 中，不会提交到仓库
# ============================================

# ---------- LLM 提供商 ----------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  # 可选，默认即可
DEEPSEEK_MODEL=deepseek-chat

# ---------- PostgreSQL 数据库 ----------
# 本地开发（直连宿主机）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contract_rag

# 容器内连接（使用 Docker 服务名）
# 注释掉上面 localhost 行，取消下面注释
# POSTGRES_HOST=postgres

# 完整连接字符串（由程序拼接，也可直接指定）
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- Redis ----------
# 本地开发
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 容器内连接
# REDIS_HOST=redis

# Celery Broker URL（由程序拼接）
# CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
# CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ---------- Qdrant 向量数据库 ----------
# 本地开发
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334  # 本项目中未使用 gRPC，保留备用

# 容器内连接
# QDRANT_HOST=qdrant

# Qdrant 集合名称
QDRANT_COLLECTION_NAME=contract_chunks

# ---------- LangFuse 可观测性（可选） ----------
# 如果使用自托管 LangFuse，填写以下变量
LANGFUSE_HOST=http://localhost:3000  # 或你的自托管地址
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx

# 如果使用 LangFuse Cloud，则替换为云地址：
# LANGFUSE_HOST=https://cloud.langfuse.com

# LangFuse 自托管所需的安全密钥（请替换为随机字符串）
LANGFUSE_NEXTAUTH_SECRET=change-me-in-production
LANGFUSE_SALT=change-me-in-production
LANGFUSE_ENCRYPTION_KEY=change-me-in-production

# ---------- Embedding 模型 ----------
# 使用 sentence-transformers 本地模型
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5  # 中文小模型，平衡速度与效果

# 跨编码器（重排序用）
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------- 应用配置 ----------
APP_NAME=Contract RAG Agent
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# API 前缀
API_V1_PREFIX=/api/v1

# 文件上传限制（字节）
MAX_UPLOAD_SIZE=10485760  # 10MB

# 临时文件目录
UPLOAD_DIR=./uploads

# ---------- 检索参数 ----------
# 召回 top-k（多路召回后融合）
RETRIEVAL_TOP_K=20

# 重排序后最终返回数量
RERANK_TOP_K=5

# RRF 融合参数 k
RRF_K=60

# 置信度阈值（低于此值触发查询改写）
CONFIDENCE_THRESHOLD=0.7

# ---------- 分块参数 ----------
# 条款分块最小字符数（低于此会合并）
MIN_CHUNK_SIZE=100

# 最大字符数（超过会强制截断）
MAX_CHUNK_SIZE=1500

# ---------- Celery 配置 ----------
CELERY_TASK_TIME_LIMIT=300  # 任务超时时间（秒）
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_WORKER_CONCURRENCY=4